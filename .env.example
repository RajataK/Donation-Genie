# =============================================================================
# Donation Genie — Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your environment.
# The .env file is gitignored and should never be committed.
# =============================================================================

# --- Django -------------------------------------------------------------------

# Secret key for cryptographic signing. MUST be changed in production.
DJANGO_SECRET_KEY=change-me-to-a-real-secret-key

# Settings module selector: "local" or "production"
DJANGO_ENV=local

# Enable Django debug mode. MUST be False in production.
DEBUG=True

# Comma-separated list of allowed HTTP Host headers.
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database -----------------------------------------------------------------

# PostgreSQL connection URL used by Django (via django-environ).
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
# For AWS RDS: postgres://user:pass@your-rds-endpoint.amazonaws.com:5432/dbname
DATABASE_URL=postgres://genie:changeme@db:5432/donation_genie

# PostgreSQL container configuration (used by docker-compose for the db service)
POSTGRES_DB=donation_genie
POSTGRES_USER=genie
POSTGRES_PASSWORD=changeme

# --- Frontend -----------------------------------------------------------------

# Base URL for API requests from the frontend.
# In local dev this is "/api" (proxied through Nginx).
# In production, set to the full API URL if hosted separately.
VITE_API_URL=/api
